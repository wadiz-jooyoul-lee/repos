#!/bin/bash

# 사용자가 명령어를 입력했는지 확인
if [ -z "$1" ]; then
    echo "❌ 실행할 명령어를 입력해주세요."
    echo "사용법: $0 [명령어]"
    echo "예시: $0 git pull"
    exit 1
fi

# 현재 폴더 하위의 모든 디렉토리 순회
for dir in */; do
    if [ -d "$dir" ]; then
        echo "========================================"
        echo "📂 디렉토리 진입: $dir"
        echo "========================================"
        
        pushd "$dir" > /dev/null
        
        # ⭐ 사용자가 터미널에 입력한 명령어를 여기서 실행합니다.
        "$@"
        
        popd > /dev/null
    fi
done

echo "✨ 모든 디렉토리 순회가 완료되었습니다."
